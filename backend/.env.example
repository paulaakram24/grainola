# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── MongoDB Atlas (free tier) ────────────────────────────────────────────────
# Sign up at https://cloud.mongodb.com → create free M0 cluster → get connection string
# Replace <username>, <password>, <cluster> and <dbname> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_REFRESH_EXPIRES_IN=7d

# ── AWS S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PRESIGNED_URL_EXPIRY=3600

# ── Groq (free) ─────────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com → API Keys
# Used for: Whisper transcription + Llama 3 summarization
GROQ_API_KEY=gsk_your-groq-key-here

# ── Google OAuth / Calendar ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/calendar/oauth/callback

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
